<?xml version="1.0"?>
<package format="2">
  <name>iiwa_control</name>
  <version>0.1.0</version>
  <description>Minimal watchdog effort controller for a single KUKA LBR iiwa.</description>
  <maintainer email="baiyu@example.com">Baiyu</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>urdf</depend>
  <exec_depend>joint_state_controller</exec_depend>

  <export>
    <controller_interface plugin="${prefix}/plugins/watchdog_effort_controller.xml"/>
  </export>
</package>
