  <description>PyBullet simulation and data logging for the stage-constraint iiwa14 setup.</description>
  <maintainer email="baiyu@example.com">Baiyu</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>iiwa_description</depend>
  <depend>nav_msgs</depend>
