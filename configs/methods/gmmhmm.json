{
  "name": "gmmhmm",
  "segmenter": {
    "max_iter": 30,
    "tol": 0.0001,
    "verbose": true,
    "n_stages": 2,
    "n_components": 3,
    "reg_covar": 0.001,
    "seed": 0,
    "use_state": true,
    "use_velocity": false,
    "velocity_weight": 1.0,
    "use_env_features": true,
    "selected_raw_feature_ids": null,
    "standardize": true,
    "init_mode": "random_stage_ends",
    "min_len": 3
  },
  "posthoc_constraint": {
    "posthoc_training_mode": "voting",
    "verbose": false,
    "selected_raw_feature_ids": null,
    "constraint_core_trim": 0,
    "plot_dir": "outputs/plots"
  }
}
